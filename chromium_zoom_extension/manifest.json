{
  "manifest_version": 3,
  "name": "Tekzite Local Browser Services",
  "version": "10.5.0",
  "description": "Local browser services and privacy enforcement for Tekzite.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "declarativeNetRequest",
    "downloads.open"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "ads.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "trackers.json"
      },
      {
        "id": "privacy_headers",
        "enabled": true,
        "path": "privacy_headers.json"
      }
    ]
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "privacy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
